# ─────────────────────────────────────────────────────────────────────────────
# SiteTrack frontend — environment variables
# Copy to .env and fill in real values.
#
# ⚠️  IMPORTANT — Vite bakes these values into the compiled JS bundle at BUILD time.
#     Changing .env after the build has no effect — you must rebuild.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Base URL ──────────────────────────────────────────────────────────────
# Development (local):
#   VITE_API_BASE_URL=http://localhost:3001/api/v1
#
# Production — same domain (Nginx proxy handles /api → backend):
#   VITE_API_BASE_URL=/api/v1
#
# Production — separate API subdomain:
#   VITE_API_BASE_URL=https://api.akconstruction.ae/api/v1
VITE_API_BASE_URL=http://localhost:3001/api/v1

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Paste your OAuth 2.0 Client ID from Google Cloud Console.
# Leave blank to hide the Google Sign-In button entirely.
# In production, add your domain to: GCP → APIs & Services → Credentials
#   → OAuth 2.0 Client → Authorised JavaScript origins
VITE_GOOGLE_CLIENT_ID=
