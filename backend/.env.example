# ─────────────────────────────────────────────────────────────────────────────
# SiteTrack backend — environment variables
# Copy to .env and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://sitetrack:changeme@localhost:5432/sitetrack
TEST_DATABASE_URL=postgres://sitetrack:changeme@localhost:5432/sitetrack_test

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=changeme_at_least_32_chars_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Google OAuth (Google Cloud Console → APIs & Services → Credentials) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Twilio Verify (https://console.twilio.com) — leave blank in dev ──────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── MinIO / S3 Storage ────────────────────────────────────────────────────────
# MINIO_ENDPOINT         — internal endpoint used by the backend to upload/read files
# MINIO_PUBLIC_ENDPOINT  — publicly accessible URL used to generate presigned download
#                          links that your users' browsers can reach.
#                          In production set this to e.g. https://storage.akconstruction.ae
#                          Leave blank in dev to fall back to MINIO_ENDPOINT.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET=sitetrack

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
# Leave blank in development to allow all origins.
# Production example: CORS_ORIGIN=https://akconstruction.ae,https://www.akconstruction.ae
CORS_ORIGIN=
