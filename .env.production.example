# ─────────────────────────────────────────────────────────────────────────────
# SiteTrack — PRODUCTION environment template
#
# HOW TO USE:
#   1. Copy this file to .env on your production VPS:
#      cp .env.production.example .env
#   2. Fill in every value marked with  ← FILL IN
#   3. Run:  docker compose up -d --build
#
# See DEPLOYMENT.md for the full step-by-step guide.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── Domain ────────────────────────────────────────────────────────────────────
# Your purchased domain (replace with actual domain after purchase)
# Frontend URL:  https://akconstruction.ae
# API URL:       https://api.akconstruction.ae
# Storage URL:   https://storage.akconstruction.ae  (if exposing MinIO publicly)

# ── CORS ──────────────────────────────────────────────────────────────────────
# The frontend domain(s) the API will accept requests from.
# Include both with and without www if needed.
CORS_ORIGIN=https://akconstruction.ae,https://www.akconstruction.ae   # ← FILL IN

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sitetrack
POSTGRES_USER=sitetrack
POSTGRES_PASSWORD=                                                     # ← FILL IN (use a strong password, e.g. openssl rand -hex 32)

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 64
JWT_SECRET=                                                            # ← FILL IN (must be 64+ random characters)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── MinIO (S3-compatible object storage) ──────────────────────────────────────
MINIO_ROOT_USER=                                                       # ← FILL IN
MINIO_ROOT_PASSWORD=                                                   # ← FILL IN (use a strong password)
MINIO_BUCKET=sitetrack

# Internal Docker network address — DO NOT CHANGE
MINIO_ENDPOINT=http://minio:9000

# Public URL for presigned download links that users' browsers reach.
# Options:
#   A) Expose MinIO port 9000 behind Nginx:  https://storage.akconstruction.ae
#   B) Use an S3-compatible CDN/bucket (Cloudflare R2, Wasabi, etc.)
#   C) Leave blank if MinIO is not publicly exposed (file downloads will fail)
MINIO_PUBLIC_ENDPOINT=https://storage.akconstruction.ae                # ← FILL IN

# ── Google OAuth ──────────────────────────────────────────────────────────────
# 1. Go to: https://console.cloud.google.com → APIs & Services → Credentials
# 2. Edit your OAuth 2.0 Client ID
# 3. Add to "Authorised JavaScript origins":  https://akconstruction.ae
# 4. Paste the Client ID below (same value for both vars)
GOOGLE_CLIENT_ID=                                                      # ← FILL IN
GOOGLE_CLIENT_SECRET=                                                  # ← FILL IN (optional, not used in token flow)

# ── Twilio Verify (SMS OTP) ───────────────────────────────────────────────────
# 1. Go to: https://console.twilio.com
# 2. Create a Verify Service and paste the credentials below
# Leave blank to disable SMS OTP (users can still log in via email/password + Google)
TWILIO_ACCOUNT_SID=                                                    # ← FILL IN
TWILIO_AUTH_TOKEN=                                                     # ← FILL IN
TWILIO_VERIFY_SERVICE_SID=                                             # ← FILL IN

# ── Frontend (Vite build-time variables) ──────────────────────────────────────
# ⚠️  These are BAKED into the JS bundle at Docker build time.
#     You must run  docker compose up -d --build  after changing these.
#
# If frontend and API are on the same server with Nginx proxying /api:
#   VITE_API_BASE_URL=/api/v1
#
# If API is on a separate subdomain (api.akconstruction.ae):
#   VITE_API_BASE_URL=https://api.akconstruction.ae/api/v1
VITE_API_BASE_URL=https://api.akconstruction.ae/api/v1                 # ← FILL IN
VITE_GOOGLE_CLIENT_ID=                                                 # ← FILL IN (same as GOOGLE_CLIENT_ID above)
