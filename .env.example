# ─────────────────────────────────────────────────────────────────────────────
# SiteTrack — Root environment variables
# Copy this to .env and fill in real values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sitetrack
POSTGRES_USER=sitetrack
POSTGRES_PASSWORD=changeme_strong_password

# ── MinIO (S3-compatible local storage) ───────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET=sitetrack
MINIO_ENDPOINT=http://minio:9000

# ── Backend ───────────────────────────────────────────────────────────────────
JWT_SECRET=changeme_at_least_32_chars_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
PORT=3001

# ── Google OAuth (Google Cloud Console → Credentials) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Twilio Verify (https://console.twilio.com) — leave blank in dev to use console log ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Frontend (Vite public env vars) ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_GOOGLE_CLIENT_ID=
