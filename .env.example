# ─────────────────────────────────────────────────────────────────────────────
# SiteTrack — Root environment variables (Docker Compose)
# Copy this file to .env and fill in real values before running.
# See DEPLOYMENT.md for a full production setup guide.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sitetrack
POSTGRES_USER=sitetrack
POSTGRES_PASSWORD=changeme_strong_password

# ── MinIO (S3-compatible object storage) ──────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET=sitetrack

# MINIO_ENDPOINT is the internal Docker network address used by the backend container.
# Do NOT change this — it uses the Docker service name 'minio'.
MINIO_ENDPOINT=http://minio:9000

# MINIO_PUBLIC_ENDPOINT is the publicly accessible URL used to generate presigned
# download links that your users' browsers can reach.
# In production: https://storage.akconstruction.ae  (or your domain)
# In local dev:  leave blank (falls back to MINIO_ENDPOINT — only works if MinIO port 9000 is exposed)
MINIO_PUBLIC_ENDPOINT=

# ── Backend ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Generate a strong random secret: openssl rand -hex 64
JWT_SECRET=changeme_at_least_32_chars_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins the API will accept requests from.
# Leave blank in development to allow all origins (unsafe in production!).
# Production example: https://akconstruction.ae,https://www.akconstruction.ae
CORS_ORIGIN=

# ── Google OAuth (Google Cloud Console → APIs & Services → Credentials) ───────
# Must add your production domain to: Authorised JavaScript origins
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Twilio Verify (https://console.twilio.com) ────────────────────────────────
# Leave blank in development — OTP code will be printed to the console instead.
# ⚠️  The demo bypass code 123456 only works when NODE_ENV != production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Frontend (passed as Docker build-args to Vite at build time) ──────────────
# ⚠️  These values are BAKED into the JS bundle. You must rebuild Docker images
#     after changing these.
#
# Same-domain deployment (Nginx on same server proxies /api → backend):
#   VITE_API_BASE_URL=/api/v1
#
# Separate API subdomain:
#   VITE_API_BASE_URL=https://api.akconstruction.ae/api/v1
#
# Local development:
#   VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_API_BASE_URL=http://localhost:3001/api/v1
VITE_GOOGLE_CLIENT_ID=
